              "language": null,
              "size_pt": 18.0,
              "underline": null
            },
            "text": "And the essential contribution of India is simply her Indianness."
          },
          {
            "bullet": false,
            "level": 0,
            "runs": [
              {
                "style": {
                  "alignment": "l",
