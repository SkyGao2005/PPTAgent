                  "italic": null,
                  "language": "en-IN",
                  "size_pt": 18.0,
                  "underline": null
                },
                "text": "All that India has to offer to the world proceeds from her philosophy."
              }
            ],
            "style": {
              "alignment": "l",
              "bold": null,
              "color": "#FFFFFF",
              "font_family": "Trebuchet MS",
              "italic": null,
              "language": null,
              "size_pt": 18.0,
              "underline": null
            },
            "text": "All that India has to offer to the world proceeds from her philosophy."
          },
          {
            "bullet": false,
            "level": 0,
            "runs": [
              {
                "style": {
                  "alignment": "l",
                  "bold": null,
