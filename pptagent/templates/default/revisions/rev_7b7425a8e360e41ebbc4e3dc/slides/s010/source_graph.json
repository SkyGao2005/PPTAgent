                "style": {
                  "alignment": null,
                  "bold": null,
                  "color": "#BCDA7D",
                  "font_family": "Trebuchet MS",
                  "italic": null,
                  "language": "en-IN",
                  "size_pt": 18.0,
                  "underline": null
                },
                "text": "Odissi"
              },
              {
                "style": {
                  "alignment": null,
                  "bold": null,
                  "color": "#BCDA7D",
                  "font_family": "Trebuchet MS",
                  "italic": null,
                  "language": "en-IN",
                  "size_pt": 18.0,
                  "underline": null
                },
                "text": "is one of the oldest dance traditions in the world today."
              }
            ],
            "style": {
              "alignment": "l",
