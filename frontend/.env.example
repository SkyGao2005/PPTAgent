# Leave empty in local development to use Vite's /api proxy.
VITE_API_BASE_URL=
# Optional: override the local Vite /api proxy target without enabling CORS.
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
# Mock mode is development-only: set VITE_USE_MOCK=1 in .env.development (or
# your own .env.development.local). Production builds ignore it — api.ts
# additionally gates the flag on import.meta.env.DEV.
# VITE_USE_MOCK=1
