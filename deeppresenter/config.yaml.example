# DeepPresenter configuration
context_folding: true
offline_mode: false
async_tool_mode: false

research_agent:
  base_url: "https://openrouter.ai/api/v1"
  model: "anthropic/claude-sonnet-4.5"
  api_key: "your_key"

design_agent:
  base_url: "https://openrouter.ai/api/v1"
  model: "google/gemini-3-pro-preview"
  api_key: "your_key"
  # Budget is checked before every request, including tool schemas and images.
  context_limit_tokens: 114688
  reserved_output_tokens: 10000
  context_safety_margin_tokens: 2000
  template_context_max_tokens: 12000
  max_template_reference_images: 2

long_context_model:
  base_url: "https://open.bigmodel.cn/api/paas/v4/"
  model: "glm-4.5"
  api_key: "your_key"

